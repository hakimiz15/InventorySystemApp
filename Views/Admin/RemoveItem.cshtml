@{
    ViewData["Title"] = "Remove Item";
    ViewData["UserType"] = "Admin";
    Layout = "_Layout";
}

@await Html.PartialAsync("_Alert")

<div class="form-container">
    <h2><i class="fas fa-minus-circle" style="color:#c1121f;"></i> Remove Item from Cabinet</h2>
    <p class="form-subtitle-danger">
        <i class="fas fa-exclamation-triangle"></i>
        Enter the exact details below. This action will reduce item quantity in the specified cabinet.
    </p>

    <form method="post" asp-action="RemoveItem" onsubmit="return confirmDelete('item quantity');">
        <div class="form-row">
            <div class="form-group">
                <label for="itemCode"><i class="fas fa-barcode"></i> Item Code</label>
                <input type="text" id="itemCode" name="itemCode" placeholder="e.g. RUN-001" required />
            </div>
            <div class="form-group">
                <label for="cabinetNumber"><i class="fas fa-warehouse"></i> Cabinet Number</label>
                <input type="text" id="cabinetNumber" name="cabinetNumber" placeholder="e.g. 1" required />
            </div>
        </div>

        <div class="form-group">
            <label for="quantity"><i class="fas fa-sort-numeric-down"></i> Quantity to Remove</label>
            <input type="number" id="quantity" name="quantity" placeholder="Enter quantity" min="1" value="1" required />
            <small class="form-help-text">
                If the quantity is equal to or greater than what's stored, the item entry will be fully removed.
            </small>
        </div>

        <div class="form-actions" style="display:flex;flex-direction:column;margin-top:30px;">
            <button type="submit" class="btn btn-danger" style="width:100%;padding:12px 20px;margin-bottom:20px;background:#c1121f !important;color:white !important;border:2px solid transparent !important;">
                <i class="fas fa-minus-circle"></i> Remove
            </button>
            <button type="reset" class="btn btn-outline" style="width:100%;padding:12px 20px;background:white !important;color:#475569 !important;border:2px solid #cbd5e1 !important;">
                <i class="fas fa-undo"></i> Clear
            </button>
        </div>
    </form>
</div>

<script>
    function confirmDelete(type) {
        return confirm('Are you sure you want to remove this ' + type + '?');
    }
</script>
