@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
    ViewData["UserType"] = "Admin";

    var results = ViewData["SearchResults"] as List<dynamic> ?? new List<dynamic>();
    bool hasResults = results.Any();
}

<div class="dashboard-container @(hasResults ? "with-results" : "centered")">
    <!-- 👋 Greeting (only if not searching) -->
    @if (!hasResults)
    {
        <div class="welcome-section fade-in">
            <h1>Welcome, Admin!</h1>
            <p class="subtext">Search for any item to see where it’s stored in your inventory.</p>
        </div>
    }

    <!-- 🔍 Search Bar -->
    <form asp-action="SearchItem" method="get" class="search-bar-container">
        <div class="search-input-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input type="text" name="itemCode" placeholder="Search item code (e.g., R001)" required />
            <button type="submit" class="search-btn">Search</button>
        </div>
    </form>

    <!-- 📦 Search Results -->
    @if (hasResults)
    {
        <div id="searchResults" class="search-results visible fade-in">
            <h3>Search Results for <span class="text-primary">@ViewData["SearchCode"]</span></h3>

            <div class="d-flex justify-content-end mb-3">
                <button type="button" id="clearSearchBtn" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Clear Search
                </button>
            </div>

            <table class="table table-bordered mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Item Name</th>
                        <th>Cabinet Number</th>
                        <th>Category</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in results)
                    {
                        <tr>
                            <td>@(result?.ItemName ?? "N/A")</td>
                            <td>@(result?.CabinetNumber ?? "N/A")</td>
                            <td>@(result?.Category ?? "N/A")</td>
                            <td>@(result?.Quantity?.ToString() ?? "0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    /* ✅ Overall layout */
    .dashboard-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 20px;
        transition: all 0.5s ease;
    }

    /* Centered view before search */
    .dashboard-container.centered {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 80vh;
        text-align: center;
    }

    /* Move up when search results appear */
    .dashboard-container.with-results {
        margin-top: 30px;
    }

    /* 👋 Greeting section */
    .welcome-section h1 {
        font-size: 2.2rem;
        font-weight: 700;
        color: #222;
        margin-bottom: 10px;
    }

    .subtext {
        font-size: 1rem;
        color: #666;
        margin-bottom: 30px;
    }

    /* 🔍 Modern Canva-like search bar */
    .search-bar-container {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
        max-width: 750px;
        background: #fff;
        border-radius: 60px;
        padding: 12px 20px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border: 1px solid #eee;
    }

    .search-input-wrapper:hover {
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }

    .search-input-wrapper:focus-within {
        box-shadow: 0 0 12px rgba(0, 140, 255, 0.4);
        transform: scale(1.01);
    }

    .search-input-wrapper input {
        flex: 1;
        border: none;
        outline: none;
        font-size: 1.05rem;
        padding: 10px 15px;
        background: transparent;
    }

    .search-icon {
        color: #888;
        font-size: 1.3rem;
        margin-left: 10px;
    }

    .search-btn {
        background: linear-gradient(90deg, #007bff, #00b4d8);
        color: #fff;
        border: none;
        border-radius: 50px;
        padding: 10px 24px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .search-btn:hover {
        background: linear-gradient(90deg, #006ae0, #009dc2);
        transform: translateY(-1px);
    }

    /* 📦 Results table */
    .search-results {
        margin-top: 50px;
        animation: fadeIn 0.8s ease;
    }

    table th, table td {
        text-align: center;
        vertical-align: middle;
    }

    #clearSearchBtn {
        background-color: #6c757d;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        transition: 0.2s;
    }

    #clearSearchBtn:hover {
        background-color: #5a6268;
    }

    /* ✨ Fade-in animation */
    .fade-in {
        animation: fadeIn 1s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const clearBtn = document.getElementById("clearSearchBtn");
        if (clearBtn) {
            clearBtn.addEventListener("click", () => {
                window.location.href = "@Url.Action("Dashboard", "Admin")";
            });
        }
    });
</script>
