@{
    ViewData["Title"] = "Remove User";
    ViewData["UserType"] = "Admin";
    Layout = "_Layout";
}

@await Html.PartialAsync("_Alert")

<div class="form-container">
    <h2><i class="fas fa-user-minus" style="color:#c1121f;"></i> Remove User</h2>
    <p class="form-subtitle-danger">
        <i class="fas fa-exclamation-triangle"></i>
        This action <strong>cannot be undone</strong>. The user account will be permanently deleted.
    </p>
    <p></p>

    <form method="post" asp-action="RemoveUser" onsubmit="return confirmDelete('user');">
        <div class="form-group">
            <label for="username"><i class="fas fa-user-circle"></i> Username</label>
            <input type="text" id="username" name="username" placeholder="Enter the username to remove" required
                   value="@ViewData["PrefillUsername"]" />
        </div>

        <div class="form-group">
            <label for="email"><i class="fas fa-envelope"></i> Email (for verification)</label>
            <input type="email" id="email" name="email" placeholder="Enter user's email address" required
                   value="@ViewData["PrefillEmail"]" />
            <small class="form-help-text">Both username and email must match to remove the user.</small>
        </div>

        <div class="form-actions" style="display:flex;flex-direction:column;margin-top:30px;">
            <button type="submit" class="btn btn-danger" style="width:100%;padding:12px 20px;margin-bottom:20px;background:#c1121f !important;color:white !important;border:2px solid transparent !important;">
                <i class="fas fa-trash-alt"></i> Remove User
            </button>
            <button type="reset" class="btn btn-outline" style="width:100%;padding:12px 20px;background:white !important;color:#475569 !important;border:2px solid #cbd5e1 !important;">
                <i class="fas fa-undo"></i> Clear
            </button>
        </div>
    </form>
</div>

<script>
    function confirmDelete(type) {
        return confirm('Are you sure you want to permanently delete this ' + type + '?\\nThis action cannot be undone.');
    }
</script>
