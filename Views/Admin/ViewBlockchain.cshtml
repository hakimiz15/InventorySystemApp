@model List<InventorySystemApp.Models.Block>
@using MongoDB.Bson
@{
    ViewData["Title"] = "Blockchain Records";
    ViewData["UserType"] = "Admin";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="mb-3">Blockchain Audit Trail</h2>

    @if (ViewBag.IsValid)
    {
        <div class="alert alert-success">✅ Blockchain Integrity: Verified</div>
    }
    else
    {
        <div class="alert alert-danger">
            ❌ Blockchain Integrity Compromised! Error at block: @ViewBag.ErrorAt
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No blockchain records found.</div>
    }
    else
    {
        <div class="table-container">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Index</th>
                        <th>User Type</th>
                        <th>Event Type</th>
                        <th>Timestamp (UTC)</th>
                        <th>Details</th>
                        <th>Hash</th>
                        <th>Prev Hash</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var block in Model)
                    {
                        <tr>
                            <td>@block.Index</td>
                            <td>@(block.Payload.GetValue("executedBy", new BsonString("Unknown User")).AsString)</td>
                            <td>@block.EventType</td>
                            <td>@block.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <pre style="font-size: 12px; white-space: pre-wrap;"><pre>@block.Payload.ToJson(new MongoDB.Bson.IO.JsonWriterSettings { Indent = true })</pre></pre>
                            </td>
                            <td style="word-break: break-all;">@block.Hash</td>
                            <td style="word-break: break-all;">@block.PrevHash</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table-container {
        margin-top: 20px;
    }

    table {
        border-collapse: collapse;
        width: 100%;
        background-color: #fff;
    }

    th, td {
        text-align: left;
        padding: 10px;
    }

    th {
        background-color: #212529;
        color: #fff;
    }

    pre {
        background-color: #f8f9fa;
        border-radius: 5px;
        padding: 8px;
        overflow-x: auto;
    }

    .alert {
        font-weight: bold;
    }
</style>
