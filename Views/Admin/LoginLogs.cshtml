@model List<InventorySystemApp.Data.LoginLog>

@{
    ViewData["Title"] = "Login Logs";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">Login Logs</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No login attempts found.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Username</th>
                    <th>Timestamp (UTC)</th>
                    <th>Success</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.Username</td>
                        <td>@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(log.Timestamp, "Singapore Standard Time").ToString("dd-MM-yyyy HH:mm:ss")</td>

                        <td>
                            @if (log.Success)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
