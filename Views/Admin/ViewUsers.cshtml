@model List<InventorySystemApp.Models.User>

@{
    ViewData["Title"] = "View Users";
    ViewData["UserType"] = "Admin";

    var q = ViewData["SearchQuery"] as string ?? string.Empty;
    var isSearch = !string.IsNullOrWhiteSpace(q);
    var any = Model != null && Model.Any();
    var total = Model?.Count ?? 0;
    var adminCount = Model?.Count(u => string.Equals(u?.Role, "admin", StringComparison.OrdinalIgnoreCase)) ?? 0;
    var userCount = total - adminCount;
}

@await Html.PartialAsync("_Alert")

<div class="vu-page">

    <!-- ============ HEADER / SEARCH BAR ============ -->
    <div class="vu-header">
        <div class="vu-head-row">
            <div>
                <h2 class="vu-title">
                    <i class="fas fa-users"></i> View Users
                </h2>
                <p class="vu-sub">Manage user accounts — search, review roles, and quickly navigate to add / delete users.</p>
            </div>
            <div class="vu-actions">
                <a asp-action="AddUser" asp-controller="Admin" class="vu-btn vu-btn-primary">
                    <i class="fas fa-user-plus"></i> Add User
                </a>
                <a asp-action="RemoveUser" asp-controller="Admin" class="vu-btn vu-btn-danger">
                    <i class="fas fa-user-minus"></i> Delete User
                </a>
            </div>
        </div>

        <form asp-action="ViewUsers" asp-controller="Admin" method="get" class="vu-search">
            <div class="vu-search-inner">
                <i class="fas fa-search vu-search-icon"></i>
                <input
                    type="text"
                    name="search"
                    value="@q"
                    placeholder="Search name, username, email, or role..."
                    class="vu-search-input"
                    autocomplete="off" />
                <button type="submit" class="vu-search-btn">Search</button>
                @if (isSearch)
                {
                    <a asp-action="ViewUsers" asp-controller="Admin" class="vu-btn vu-btn-outline">
                        <i class="fas fa-times"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- ============ STATS ============ -->
    <div class="vu-stats">
        <div class="vu-stat-card">
            <div class="vu-stat-ico vu-stat-ico-blue"><i class="fas fa-user-friends"></i></div>
            <div>
                <small>Total Users</small>
                <h3>@total</h3>
            </div>
        </div>
        <div class="vu-stat-card">
            <div class="vu-stat-ico vu-stat-ico-red"><i class="fas fa-shield-halved"></i></div>
            <div>
                <small>Admin</small>
                <h3>@adminCount</h3>
            </div>
        </div>
        <div class="vu-stat-card">
            <div class="vu-stat-ico vu-stat-ico-green"><i class="fas fa-user"></i></div>
            <div>
                <small>Regular Users</small>
                <h3>@userCount</h3>
            </div>
        </div>
        @if (isSearch)
        {
            <div class="vu-stat-card vu-stat-ghost">
                <div class="vu-stat-ico"><i class="fas fa-search"></i></div>
                <div>
                    <small>Query</small>
                    <h4 style="margin:4px 0 0;font-size:14px;">
                        <code class="vu-q-chip">@q</code>
                    </h4>
                </div>
            </div>
        }
    </div>

    <!-- ============ EMPTY STATE ============ -->
    @if (!any)
    {
        <div class="vu-empty">
            @if (isSearch)
            {
                <i class="fas fa-search vu-empty-icon vu-empty-icon-warn"></i>
                <p class="vu-empty-title">No users match "@q"</p>
                <p class="vu-empty-sub">Try a different keyword or clear the filter.</p>
                <a asp-action="ViewUsers" asp-controller="Admin" class="vu-btn vu-btn-primary" style="margin-top:14px;">
                    <i class="fas fa-times"></i> Clear Search
                </a>
            }
            else
            {
                <i class="fas fa-user-slash vu-empty-icon"></i>
                <p class="vu-empty-title">No user accounts yet</p>
                <p class="vu-empty-sub">Create your first user account to get started.</p>
                <a asp-action="AddUser" asp-controller="Admin" class="vu-btn vu-btn-primary" style="margin-top:14px;">
                    <i class="fas fa-user-plus"></i> Add First User
                </a>
            }
        </div>
    }
    else
    {
        <!-- ============ USERS TABLE ============ -->
        <div class="vu-table-wrap">
            <table class="vu-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>User</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th class="vu-col-actions">Quick Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model!.Count; i++)
                    {
                        var u = Model[i];
                        var isAdmin = string.Equals(u?.Role, "admin", StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td class="vu-idx">@(i + 1)</td>
                            <td>
                                <div class="vu-user-cell">
                                    <div class="vu-avatar @(isAdmin ? "vu-avatar-admin" : "")">
                                        @{
                                            string initials = "?";
                                            string? first = u?.FirstName;
                                            string? last  = u?.LastName;
                                            if (!string.IsNullOrEmpty(first) || !string.IsNullOrEmpty(last))
                                            {
                                                initials = string.Concat(
                                                    string.IsNullOrEmpty(first) ? "" : char.ToUpperInvariant(first[0]).ToString(),
                                                    string.IsNullOrEmpty(last)  ? "" : char.ToUpperInvariant(last[0]).ToString()
                                                );
                                            }
                                        }
                                        @initials
                                    </div>
                                    <div>
                                        <strong class="vu-name">@u?.FirstName @u?.LastName</strong>
                                        <br />
                                        <small class="vu-muted">Account ID: @u?.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <code class="vu-code">@u?.Username</code>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(u?.Email))
                                {
                                    <a class="vu-email" href="mailto:@u?.Email">@u?.Email</a>
                                }
                                else
                                {
                                    <span class="vu-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (isAdmin)
                                {
                                    <span class="vu-role-badge vu-role-admin">
                                        <i class="fas fa-shield-halved"></i> ADMIN
                                    </span>
                                }
                                else
                                {
                                    <span class="vu-role-badge vu-role-user">
                                        <i class="fas fa-user"></i> USER
                                    </span>
                                }
                            </td>
                            <td class="vu-col-actions">
                                <a asp-action="RemoveUser" asp-controller="Admin"
                                   asp-route-username="@u?.Username"
                                   class="vu-link vu-link-danger"
                                   title="Pre-fill delete form with this user">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    /* ========== PAGE WRAPPER ========== */
    .vu-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 20px 80px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #111827;
    }

    /* ========== HEADER ========== */
    .vu-header { margin-bottom: 22px; }
    .vu-head-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }
    .vu-title {
        margin: 0 0 6px;
        font-weight: 700;
        font-size: 24px;
        color: #0f172a;
    }
    .vu-title i {
        color: #4f46e5;
        margin-right: 10px;
    }
    .vu-sub {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
        max-width: 620px;
    }
    .vu-actions {
        display: inline-flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .vu-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        border: 1px solid transparent;
        transition: background .15s, border-color .15s, color .15s, transform .1s;
    }
    .vu-btn:hover { transform: translateY(-1px); text-decoration: none; }
    .vu-btn-primary { background: #4f46e5; color: white; }
    .vu-btn-primary:hover { background: #4338ca; color: white; }
    .vu-btn-danger { background: #dc2626; color: white; }
    .vu-btn-danger:hover { background: #b91c1c; color: white; }
    .vu-btn-outline {
        background: white;
        color: #374151;
        border-color: #d1d5db;
    }
    .vu-btn-outline:hover { background: #f9fafb; border-color: #9ca3af; color: #111827; }

    /* ========== SEARCH ========== */
    .vu-search {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 14px 16px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .vu-search-inner {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
        flex-wrap: wrap;
    }
    .vu-search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 14px;
        pointer-events: none;
    }
    .vu-search-input {
        flex: 1;
        min-width: 220px;
        padding: 10px 14px 10px 36px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 14px;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
    }
    .vu-search-input:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }
    .vu-search-btn {
        padding: 10px 18px;
        background: #4f46e5;
        color: white;
        border: 1px solid transparent;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: background .15s;
    }
    .vu-search-btn:hover { background: #4338ca; }

    /* ========== STATS ========== */
    .vu-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }
    .vu-stat-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .vu-stat-ghost { background: #f5f3ff; border-color: #ddd6fe; }
    .vu-stat-ico {
        width: 42px; height: 42px;
        border-radius: 10px;
        background: #e5e7eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #4b5563;
        font-size: 15px;
        flex: 0 0 42px;
    }
    .vu-stat-ico-blue  { background: #dbeafe; color: #1d4ed8; }
    .vu-stat-ico-red   { background: #fee2e2; color: #b91c1c; }
    .vu-stat-ico-green { background: #dcfce7; color: #15803d; }
    .vu-stat-card small { color: #6b7280; font-size: 12px; }
    .vu-stat-card h3 { margin: 2px 0 0; font-size: 22px; font-weight: 800; color: #0f172a; }
    .vu-q-chip {
        background: white;
        border: 1px solid #c4b5fd;
        color: #111827;
        padding: 2px 10px;
        border-radius: 6px;
        font-size: 13px;
    }

    /* ========== EMPTY ========== */
    .vu-empty {
        text-align: center;
        padding: 48px 20px;
        background: white;
        border: 1px dashed #e5e7eb;
        border-radius: 14px;
    }
    .vu-empty-icon { font-size: 42px; color: #9ca3af; margin-bottom: 12px; }
    .vu-empty-icon-warn { color: #f59e0b; }
    .vu-empty-title { margin: 0 0 4px; font-size: 17px; font-weight: 700; }
    .vu-empty-sub { margin: 0; color: #6b7280; font-size: 14px; }

    /* ========== TABLE ========== */
    .vu-table-wrap {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .vu-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }
    .vu-table thead {
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
    }
    .vu-table th {
        text-align: left;
        padding: 12px 16px;
        font-weight: 700;
        color: #374151;
        font-size: 12px;
        letter-spacing: .2px;
        text-transform: uppercase;
    }
    .vu-table td {
        padding: 14px 16px;
        border-top: 1px solid #f1f5f9;
        vertical-align: middle;
        color: #111827;
    }
    .vu-table tbody tr:hover { background: #fafbff; }
    .vu-idx {
        width: 54px;
        text-align: center;
        color: #6b7280;
        font-weight: 600;
        font-size: 13px;
    }

    .vu-user-cell { display: flex; align-items: center; gap: 12px; }
    .vu-avatar {
        width: 40px; height: 40px;
        border-radius: 50%;
        background: #818cf8;
        color: white;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex: 0 0 40px;
        text-transform: uppercase;
        letter-spacing: .3px;
        box-shadow: inset 0 0 0 2px rgba(255,255,255,.35);
    }
    .vu-avatar-admin { background: #ef4444; }
    .vu-name { font-size: 14px; }
    .vu-muted { color: #9ca3af; font-size: 11px; }
    .vu-code {
        background: #f3f4f6;
        color: #111827;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 13px;
        font-family: ui-monospace, Consolas, monospace;
    }
    .vu-email {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 500;
    }
    .vu-email:hover { text-decoration: underline; }

    /* Role badges */
    .vu-role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: .4px;
    }
    .vu-role-admin { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    .vu-role-user  { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }

    /* Actions */
    .vu-col-actions { width: 140px; text-align: right; white-space: nowrap; }
    .vu-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        text-decoration: none;
        font-weight: 600;
        padding: 6px 10px;
        border-radius: 8px;
    }
    .vu-link-danger { color: #dc2626; background: #fef2f2; border: 1px solid #fecaca; }
    .vu-link-danger:hover { background: #fee2e2; color: #b91c1c; text-decoration: none; }

    @@media (max-width: 760px) {
        .vu-table th:nth-child(6),
        .vu-table td:nth-child(6) { display: none; }
        .vu-name { font-size: 13px; }
        .vu-avatar { width: 34px; height: 34px; font-size: 12px; flex: 0 0 34px; }
    }
</style>
