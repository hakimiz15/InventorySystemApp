@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "User Dashboard";
    ViewData["UserType"] = "User";
}

@await Html.PartialAsync("_Alert")

<div class="dashboard-search-wrap">
    <form asp-action="SearchCabinet" asp-controller="User" method="get" class="dashboard-search-form" id="userDashboardSearchForm">
        <div class="dashboard-search-field">
            <i class="fas fa-search search-icon"></i>
            <input
                type="text"
                id="userDashboardSearchInput"
                name="search"
                placeholder="Enter item code, cabinet #, or category to search..."
                autocomplete="off" />
            <button type="submit" class="search-submit-btn">
                <i class="fas fa-search"></i> Search
            </button>
        </div>
        <p class="search-hint">
            <i class="fas fa-lightbulb"></i>
            Tip: search by <strong>Item Code</strong> (e.g. RUN-001), <strong>Cabinet #</strong> (e.g. 1), or <strong>Category</strong> (e.g. Running).
        </p>
    </form>
</div>

<div class="center-content">
    <h1 class="heading">Welcome, User!</h1>
    <p class="subheading">Organize your overstocks and lessen your workload!</p>
</div>

<style>
    .dashboard-search-wrap {
        max-width: 720px;
        margin: 30px auto 10px;
        padding: 24px 28px;
        background: white;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.08);
    }
    .dashboard-search-form .dashboard-search-field {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
    }
    .dashboard-search-form .search-icon {
        position: absolute;
        left: 16px;
        color: #94a3b8;
        font-size: 16px;
        pointer-events: none;
    }
    .dashboard-search-form input[type=text] {
        flex: 1;
        padding: 14px 16px 14px 42px;
        font-size: 15px;
        border: 2px solid #cbd5e1;
        border-radius: 10px;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
    }
    .dashboard-search-form input[type=text]:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
    }
    .dashboard-search-form .search-submit-btn {
        padding: 14px 20px;
        font-size: 15px;
        font-weight: 600;
        color: white;
        background: #0f766e;
        border: 2px solid transparent;
        border-radius: 10px;
        cursor: pointer;
        white-space: nowrap;
        transition: background .2s, transform .05s;
    }
    .dashboard-search-form .search-submit-btn:hover { background: #0d5f58; }
    .dashboard-search-form .search-submit-btn:active { transform: translateY(1px); }
    .search-hint {
        margin: 14px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }
    .search-hint i { color: #f59e0b; margin-right: 4px; }
    .search-hint strong { color: #334155; }
</style>

<script>
    (function () {
        var form = document.getElementById('userDashboardSearchForm');
        var input = document.getElementById('userDashboardSearchInput');
        if (!form || !input) return;

        form.addEventListener('submit', function (e) {
            if (input.value.trim() === '') {
                e.preventDefault();
                input.focus();
                input.style.borderColor = '#ef4444';
                setTimeout(function () { input.style.borderColor = ''; }, 1400);
            }
        });
    })();
</script>
